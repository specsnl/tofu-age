{
  "name": "Tags must have v-prefix",
  "target": "tag",
  "source_type": "Repository",
  "source": "specsnl/tofu-age",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [
        "refs/tags/v*"
      ],
      "include": [
        "~ALL"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    },
    {
      "type": "non_fast_forward"
    }
  ],
  "bypass_actors": []
}
